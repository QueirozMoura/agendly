# Copie para .env (não versionado) e ajuste. Apenas nomes e valores de exemplo para desenvolvimento local.
POSTGRES_USER=agendly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agendly
POSTGRES_PORT=5432

# Backend (Etapa 2). A senha e o banco devem coincidir com os valores acima; a porta, com POSTGRES_PORT.
DATABASE_URL=postgresql://agendly:change-me@localhost:5432/agendly
# HOST=127.0.0.1
# PORT=3000
# LOG_LEVEL=info
# NODE_ENV=development
# Origens permitidas para POST/PUT/PATCH/DELETE (proteção CSRF). Padrão em dev: http://localhost:5173.
# Obrigatória em produção, ex.: ALLOWED_ORIGINS=https://app.exemplo.com
# ALLOWED_ORIGINS=http://localhost:5173
# Use TRUST_PROXY=true SOMENTE atrás de proxy reverso confiável (Caddy/Nginx); sem isso, o limite de
# tentativas por IP enxergaria o IP do proxy. Em dev direto, deixe false.
# TRUST_PROXY=false
# URL pública da SPA, usada nos links dos e-mails. Padrão: a primeira de ALLOWED_ORIGINS.
# APP_BASE_URL=http://localhost:5173
# Chaves AES-256 do payload da outbox de e-mail: `id:base64,id2:base64` (32 bytes cada) + id da corrente.
# Obrigatórias em produção (a API não sobe sem elas); em dev/teste há uma chave fixa pública.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA versionar nem guardar no mesmo backup do banco. Para rotacionar: adicione a nova chave, mude
# OUTBOX_CURRENT_KEY_ID e só remova a antiga quando não restar linha cifrada com ela.
# OUTBOX_ENCRYPTION_KEYS=k1:<base64>
# OUTBOX_CURRENT_KEY_ID=k1
