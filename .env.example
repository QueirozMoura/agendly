# Copie para .env (não versionado) e ajuste. Apenas nomes e valores de exemplo para desenvolvimento local.
POSTGRES_USER=agendly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agendly
POSTGRES_PORT=5432

# Backend (Etapa 2). A senha e o banco devem coincidir com os valores acima; a porta, com POSTGRES_PORT.
DATABASE_URL=postgresql://agendly:change-me@localhost:5432/agendly
