generator client {
  provider        = "prisma-client"
  previewFeatures = ["relationJoins"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Etapa 3: apenas a fundação de identidade (seção 5 de docs/ARCHITECTURE.md).
// IDs: UUID v7 gerado no cliente pelo Prisma; ver docs/STAGE-3-VALIDATIONS.md (V2).

enum MembershipRole {
  OWNER // MVP: único valor (V16 — enum nativo; ADMIN entra depois com ALTER TYPE ... ADD VALUE)
}

enum OrganizationStatus {
  ACTIVE
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  email              String    @unique // sempre minúsculo (CHECK users_email_lowercase, SQL manual)
  passwordHash       String    @map("password_hash")
  name               String
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz(3)
  credentialsVersion Int       @default(0) @map("credentials_version")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships  Membership[]
  sessions     Session[]
  authTokens   AuthToken[]
  appointments Appointment[]

  @@map("users")
}

model Organization {
  id                              String             @id @default(uuid(7)) @db.Uuid
  name                            String
  slug                            String             @unique
  timezone                        String // IANA; imutável após a criação (R9)
  status                          OrganizationStatus @default(ACTIVE)
  publishedAt                     DateTime?          @map("published_at") @db.Timestamptz(3)
  publicMinNoticeMinutes          Int                @default(120) @map("public_min_notice_minutes")
  publicMaxAdvanceDays            Int                @default(60) @map("public_max_advance_days")
  publicMaxActiveBookingsPerPhone Int                @default(3) @map("public_max_active_bookings_per_phone")
  createdAt                       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  sessions      Session[]
  services      Service[]
  professionals Professional[]
  customers     Customer[]

  @@map("organizations")
}

model Membership {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Session {
  id                   String    @id @default(uuid(7)) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  tokenHash            String    @unique @map("token_hash")
  activeOrganizationId String?   @map("active_organization_id") @db.Uuid
  credentialsVersion   Int       @map("credentials_version")
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ip                   String?
  userAgent            String?   @map("user_agent")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// --- Etapa 5: outbox transacional de e-mail (3.6). Tabela global (sem organization_id). ---

enum EmailTemplate {
  VERIFY_EMAIL
  RESET_PASSWORD
  PASSWORD_CHANGED
  ACCOUNT_EXISTS
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  DEAD
}

enum EmailDeadReason {
  MAX_ATTEMPTS
  EXPIRED
  PERMANENT_ERROR
  KEY_UNAVAILABLE
  DECRYPT_FAILED
}

model EmailOutbox {
  id               String            @id @default(uuid(7)) @db.Uuid
  toEmail          String            @map("to_email")
  template         EmailTemplate
  // AES-256-GCM: iv(12) | tag(16) | texto cifrado. NULL depois de SENT/DEAD (CHECK email_outbox_payload_lifecycle).
  payloadEncrypted Bytes?            @map("payload_encrypted")
  keyId            String?           @map("key_id")
  status           EmailOutboxStatus @default(PENDING)
  deadReason       EmailDeadReason?  @map("dead_reason")
  attempts         Int               @default(0)
  nextAttemptAt    DateTime          @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil      DateTime?         @map("locked_until") @db.Timestamptz(3)
  lockToken        String?           @map("lock_token") @db.Uuid
  notAfter         DateTime          @map("not_after") @db.Timestamptz(3)
  lastError        String?           @map("last_error")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt           DateTime?         @map("sent_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([status, lockedUntil])
  @@map("email_outbox")
}

// --- Etapa 7: serviços (seção 5). Escopado por empresa; pai de FKs compostas das etapas 8 e 10. ---

model Service {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String
  // Duração livre (inteiro >= 1), independente da grade de 15 min. CHECKs de piso no SQL manual da migration.
  durationMinutes Int      @map("duration_minutes")
  // Tempo de preparação DEPOIS do atendimento (6.3); padrão 0.
  bufferMinutes   Int      @default(0) @map("buffer_minutes")
  priceCents      Int?     @map("price_cents")
  // Serviços não são apagados (R-c): desativam-se.
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  professionals ProfessionalService[]
  appointments  Appointment[]

  // Alvo das FKs compostas (organization_id, service_id) de professional_services e appointments.
  @@unique([organizationId, id])
  @@index([organizationId, active, name])
  @@map("services")
}

// --- Etapa 8: profissionais (sem login, D2) e vínculo com serviços (seção 5) ---

model Professional {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  // Profissionais não são apagados (R-c): desativam-se. Não há `user_id` (D2).
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  services     ProfessionalService[]
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  appointments Appointment[]

  // Alvo das FKs compostas (organization_id, professional_id) de professional_services, working_hours, time_off e da etapa 10.
  @@unique([organizationId, id])
  @@index([organizationId, active, name])
  @@map("professionals")
}

// Vínculo N:N. As duas FKs são COMPOSTAS com organization_id: o banco impede vincular um profissional a um
// serviço de outra empresa (RESTRICT em delete e update; nunca SET NULL).
model ProfessionalService {
  organizationId String   @map("organization_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  professional Professional @relation(fields: [organizationId, professionalId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  service      Service      @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([professionalId, serviceId])
  @@index([organizationId, serviceId])
  @@map("professional_services")
}

// Expediente semanal em hora LOCAL da empresa (6.1). `weekday` 0 = domingo ... 6 = sábado. Os horários são MINUTOS desde
// 00:00 local (0–1440; 1440 = meia-noite seguinte), múltiplos de 15: o `time` do Postgres chega ao Prisma como `Date` e não
// representa 24:00. Vários intervalos por dia; a sobreposição no mesmo dia é barrada na aplicação (sob a trava N2) e, como
// rede de segurança, por EXCLUDE na migration (SQL manual). CHECKs de faixa também na migration.
model WorkingHours {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  weekday        Int      @db.SmallInt
  startMinute    Int      @map("start_minute") @db.SmallInt
  endMinute      Int      @map("end_minute") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  professional Professional @relation(fields: [organizationId, professionalId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, professionalId, weekday, startMinute])
  @@map("working_hours")
}

// Folga/ausência do profissional (instantes absolutos). `CHECK (ends_at > starts_at)` na migration.
model TimeOff {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  startsAt       DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime @map("ends_at") @db.Timestamptz(3)
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  professional Professional @relation(fields: [organizationId, professionalId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, professionalId, startsAt])
  @@map("time_off")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  PANEL
  PUBLIC
}

// Cliente final da empresa (dado pessoal, LGPD). Sem `DELETE` (R-c): é pai de `appointments`. Telefone único por
// empresa; o cadastro de um telefone existente NÃO sobrescreve os dados já guardados.
model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  phoneE164      String   @map("phone_e164")
  email          String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  appointments Appointment[]

  // Alvo das FKs compostas (organization_id, customer_id) de appointments.
  @@unique([organizationId, id])
  @@unique([organizationId, phoneE164])
  @@map("customers")
}

// Agendamento (5, 6.1). `ends_at = starts_at + duração` e `blocked_until = ends_at + buffer`, calculados por
// `computeAppointmentRange` e verificados pelo banco (CHECK `appointments_range_coherent`, SQL manual). A exclusão
// `appointments_no_overlap` (SQL manual) impede dois ativos sobrepostos do mesmo profissional.
model Appointment {
  id                      String            @id @default(uuid(7)) @db.Uuid
  organizationId          String            @map("organization_id") @db.Uuid
  professionalId          String            @map("professional_id") @db.Uuid
  serviceId               String            @map("service_id") @db.Uuid
  customerId              String            @map("customer_id") @db.Uuid
  startsAt                DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt                  DateTime          @map("ends_at") @db.Timestamptz(3)
  blockedUntil            DateTime          @map("blocked_until") @db.Timestamptz(3)
  status                  AppointmentStatus @default(SCHEDULED)
  serviceNameSnapshot     String            @map("service_name_snapshot")
  durationMinutesSnapshot Int               @map("duration_minutes_snapshot")
  bufferMinutesSnapshot   Int               @map("buffer_minutes_snapshot")
  priceCentsSnapshot      Int?              @map("price_cents_snapshot")
  source                  AppointmentSource
  createdByUserId         String?           @map("created_by_user_id") @db.Uuid
  cancelledAt             DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelReason            String?           @map("cancel_reason")
  // Controle otimista de edição concorrente no painel (6.6): `UPDATE … WHERE version = $n`.
  version                 Int               @default(1)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  professional Professional        @relation(fields: [organizationId, professionalId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  service      Service             @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  customer     Customer            @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User?               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  idempotency  IdempotencyRecord[]

  // Alvo da FK composta de idempotency_records.
  @@unique([organizationId, id])
  @@index([organizationId, professionalId, startsAt])
  @@index([organizationId, customerId, startsAt])
  @@index([organizationId, startsAt])
  @@map("appointments")
}

// Registro de idempotência (6.4): vigente por 24 h. Só aparece no mesmo commit do agendamento (sem estado "em andamento").
model IdempotencyRecord {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scope          String
  key            String   @db.Uuid
  requestHash    String   @map("request_hash")
  appointmentId  String?  @map("appointment_id") @db.Uuid
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  appointment Appointment? @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
